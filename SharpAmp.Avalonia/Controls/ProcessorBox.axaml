<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpAmp.Avalonia.ViewModels"
             x:Class="SharpAmp.Avalonia.Controls.ProcessorBox"
             x:DataType="vm:ProcessorViewModel" x:CompileBindings="True"
             Width="236" Height="144" Focusable="True" AutomationProperties.Name="{Binding Name}">
    <UserControl.Styles>
        <Style Selector="Border.pedal"><Setter Property="BorderBrush" Value="#3B454D" /></Style>
        <Style Selector="Border.pedal.selected"><Setter Property="BorderBrush" Value="#85E0BE" /></Style>
        <Style Selector="Border.pedal.bypassed"><Setter Property="Opacity" Value="0.6" /></Style>
        <Style Selector="Button.port">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" /><Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#687881" /><Setter Property="Background" Value="#111417" />
            <Setter Property="Cursor" Value="Cross" />
        </Style>
        <Style Selector="Button.port.connected"><Setter Property="BorderBrush" Value="#85E0BE" /></Style>
        <Style Selector="Button.port.target /template/ ContentPresenter">
            <Setter Property="Background" Value="#85E0BE" /><Setter Property="BorderBrush" Value="#B9F5DE" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Border Classes="pedal" Classes.selected="{Binding IsSelected}" Classes.bypassed="{Binding IsBypassed}"
                Background="#20262C" BorderThickness="1.5" CornerRadius="10" Margin="10,0"
                BoxShadow="0 4 12 0 #22000000">
            <Grid RowDefinitions="*,Auto">
                <Border Padding="15,13,15,8" Background="Transparent" PointerPressed="OnDragPressed" Cursor="SizeAll">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Category}" Foreground="{Binding Accent}" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2" />
                            <TextBlock Grid.Column="1" Text="{Binding OrderLabel}" Classes="muted" FontSize="11" />
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConnectionLabel}" FontSize="10" Classes="muted" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="#354049" BorderThickness="0,1,0,0" Padding="13,2">
                    <ToggleSwitch IsChecked="{Binding IsBypassed, Mode=TwoWay}" OnContent="Bypassed" OffContent="Effect on"
                                  FontSize="11" MinHeight="32" ToolTip.Tip="Skip this effect. Its settings are kept."
                                  AutomationProperties.Name="{Binding Name, StringFormat='{}Bypass {0}'}" />
                </Border>
            </Grid>
        </Border>
        <Button x:Name="InputPort" Classes="port" Classes.connected="{Binding InputConnected}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnInputClicked"
                ToolTip.Tip="Input · drag to an output, or click the two ports. Right-click to disconnect." AutomationProperties.Name="Connect to effect input" />
        <Button x:Name="OutputPort" Classes="port" Classes.connected="{Binding OutputConnected}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOutputClicked"
                ToolTip.Tip="Output · drag to an input, or click the two ports. Right-click to disconnect." AutomationProperties.Name="Connect from effect output" />
    </Grid>
</UserControl>
