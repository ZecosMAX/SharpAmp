<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpAmp.Avalonia.ViewModels"
             xmlns:audio="clr-namespace:SharpAmp.Core.Audio;assembly=SharpAmp.Core"
             x:Class="SharpAmp.Avalonia.Views.AudioSettingsView"
             x:DataType="vm:AudioSettingsViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FormatString" Value="0" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#EDF2F4" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#95A2AC" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="#191E23" />
            <Setter Property="BorderBrush" Value="#303840" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="StackPanel.device">
            <Setter Property="Width" Value="300" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="Margin" Value="0,0,20,12" />
        </Style>
        <Style Selector="StackPanel.field">
            <Setter Property="Width" Value="200" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="Margin" Value="0,0,20,12" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="18">
        <Border Classes="section">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Audio devices" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshDevicesCommand}"
                            AutomationProperties.Name="Refresh audio devices" ToolTip.Tip="Find newly connected devices" />
                </Grid>
                <TextBlock Classes="hint" Text="Choose where your sound comes from and where you want to hear it. WASAPI is a good starting point for most devices." />
                <WrapPanel>
                    <StackPanel Classes="device">
                        <TextBlock Text="INPUT" FontSize="11" LetterSpacing="1.5" Foreground="#85E0BE" FontWeight="SemiBold" />
                        <TextBlock Text="Audio driver" />
                        <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding Settings.InputBackend, Mode=TwoWay}"
                                  AutomationProperties.Name="Input audio driver" />
                        <TextBlock Text="Microphone or instrument" Margin="0,4,0,0" />
                        <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding Settings.InputDevice, Mode=TwoWay}"
                                  PlaceholderText="Choose an input device" AutomationProperties.Name="Input device">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="audio:AudioDevice">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="hint" Text="{Binding InputDeviceMessage}" />
                    </StackPanel>
                    <StackPanel Classes="device">
                        <TextBlock Text="OUTPUT" FontSize="11" LetterSpacing="1.5" Foreground="#85E0BE" FontWeight="SemiBold" />
                        <TextBlock Text="Audio driver" />
                        <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding Settings.OutputBackend, Mode=TwoWay}"
                                  AutomationProperties.Name="Output audio driver" />
                        <TextBlock Text="Headphones or speakers" Margin="0,4,0,0" />
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding Settings.OutputDevice, Mode=TwoWay}"
                                  PlaceholderText="Choose an output device" AutomationProperties.Name="Output device">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="audio:AudioDevice">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="hint" Text="{Binding OutputDeviceMessage}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Expander Header="Advanced audio settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="18" Margin="0,12,0,0">
                <Border Classes="section">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Audio format" FontSize="17" FontWeight="SemiBold" />
                        <WrapPanel>
                            <StackPanel Classes="field">
                                <TextBlock Text="Sample rate (Hz)" />
                                <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding Settings.SampleRate, Mode=TwoWay}" AutomationProperties.Name="Sample rate in Hz" />
                            </StackPanel>
                            <StackPanel Classes="field">
                                <TextBlock Text="Input channels" />
                                <NumericUpDown Value="{Binding Settings.InputChannels, Mode=TwoWay}" Minimum="1" Maximum="32" Increment="1" AutomationProperties.Name="Input channels" />
                            </StackPanel>
                            <StackPanel Classes="field">
                                <TextBlock Text="Output channels" />
                                <NumericUpDown Value="{Binding Settings.OutputChannels, Mode=TwoWay}" Minimum="1" Maximum="32" Increment="1" AutomationProperties.Name="Output channels" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Classes="hint" Text="The defaults suit most setups. Your device's format support is checked when audio starts." />
                    </StackPanel>
                </Border>
                <Border Classes="section">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Latency and buffering" FontSize="17" FontWeight="SemiBold" />
                        <WrapPanel>
                            <StackPanel Classes="field">
                                <TextBlock Text="Requested latency (ms)" />
                                <NumericUpDown Value="{Binding Settings.LatencyMilliseconds, Mode=TwoWay}" Minimum="5" Maximum="1000" Increment="5" AutomationProperties.Name="Requested latency in milliseconds" />
                            </StackPanel>
                            <StackPanel Classes="field">
                                <TextBlock Text="Buffer duration (ms)" />
                                <NumericUpDown Value="{Binding Settings.BufferMilliseconds, Mode=TwoWay}" Minimum="10" Maximum="5000" Increment="10" AutomationProperties.Name="Buffer duration in milliseconds" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Classes="hint" Text="Lower latency feels more immediate. If you hear clicks or dropouts, increase the buffer. Keep it at least twice the requested latency." />
                        <TextBlock Classes="hint" IsVisible="{Binding UsesAsio}" Text="For ASIO, the hardware buffer is set in your driver. This buffer controls the app's audio queue." />
                    </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding UsesAsio}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="ASIO channel routing" FontSize="17" FontWeight="SemiBold" />
                        <WrapPanel>
                            <StackPanel Classes="field" IsVisible="{Binding IsAsioInput}">
                                <TextBlock Text="Input channel offset" />
                                <NumericUpDown Value="{Binding Settings.AsioInputChannelOffset, Mode=TwoWay}" Minimum="0" Maximum="2147483647" Increment="1" AutomationProperties.Name="ASIO input channel offset" />
                            </StackPanel>
                            <StackPanel Classes="field" IsVisible="{Binding IsAsioOutput}">
                                <TextBlock Text="Output channel offset" />
                                <NumericUpDown Value="{Binding Settings.AsioOutputChannelOffset, Mode=TwoWay}" Minimum="0" Maximum="2147483647" Increment="1" AutomationProperties.Name="ASIO output channel offset" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Classes="hint" Text="Use 0 for the first hardware channel, 1 for the second, and so on." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Expander>
        <TextBlock Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationError}"
                   TextWrapping="Wrap" Foreground="#EDC78A" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
