<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SharpAmp.Avalonia.ViewModels"
        xmlns:views="using:SharpAmp.Avalonia.Views"
        x:Class="SharpAmp.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" x:CompileBindings="True"
        Title="SharpAmp · Your sound, connected" Width="1380" Height="880" MinWidth="700" MinHeight="700">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Background="#191E23" BorderBrush="#2C343B" BorderThickness="0,0,0,1" Padding="24,17">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#85E0BE" CornerRadius="9" Width="38" Height="38">
                        <TextBlock Text="ϟ" Foreground="#10251D" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1">
                        <TextBlock Text="SharpAmp" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Classes="eyebrow" Text="YOUR SOUND, CONNECTED" FontSize="9" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <ToggleSwitch IsChecked="{Binding IsChainBypassed, Mode=TwoWay}" Content="Bypass all" VerticalAlignment="Center"
                                  ToolTip.Tip="Listen to your clean input without changing your effects." />
                    <Button Classes="primary audio-toggle" Classes.running="{Binding IsEngineRunning}" Command="{Binding ToggleEngineCommand}"
                            Content="{Binding EngineButtonText}" AutomationProperties.Name="{Binding EngineButtonText}" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="24,12,24,0" Spacing="8">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Classes="muted engine-status" Classes.live="{Binding IsEngineRunning}"
                           Text="{Binding EngineStatusLabel}" FontSize="12" />
                <TextBlock Grid.Column="1" Classes="muted" Text=" · " FontSize="12" />
                <TextBlock Grid.Column="2" Classes="muted" Text="{Binding EngineStatusDetail}" TextWrapping="Wrap" FontSize="12" />
            </Grid>
            <Border IsVisible="{Binding HasEngineError}" Background="#392526" CornerRadius="7" Padding="12">
                <TextBlock Text="{Binding EngineError}" Foreground="#FFB4AB" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        <TabControl Grid.Row="2" Margin="16,4,16,16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Pedalboard"><views:ProcessorChainView x:Name="Editor" DataContext="{Binding ProcessorChain}" /></TabItem>
            <TabItem Header="Settings"><views:SettingsView DataContext="{Binding Settings}" /></TabItem>
        </TabControl>
    </Grid>
</Window>
